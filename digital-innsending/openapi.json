    "url" : "https://innsending.test.domstol.no",
    "description" : "Testmiljø"
  }, {
    "url" : "http://localhost:8080",
    "description" : "Lokalt utviklingsmiljø"
  } ],
  "tags" : [ {
    "name" : "Strukturert innsending",
    "description" : "Strukturert innsending til domstolene"
  }, {
    "name" : "Innsending av filer",
    "description" : "Innsending av filer til domstolene"
  } ],
  "paths" : {
    "/api/offentlig/innsendinger/strukturert" : {
      "post" : {
        "tags" : [ "Strukturert innsending" ],
        "summary" : "Opplastning av strukturerte skjema",
        "description" : " Et POST-endepunkt for å sende inn strukturerte skjema.\n Sendes inn etter at eventuelle vedlegg har blitt lastet opp på vedlegg-endepunktet.\n\n Skjemadefinisjonen finnes i Schema-sekjsonen og heter 'Hoveddokumentskjema_v0_0_1.\n Det finnes også en skjemadefinisjon som heter 'Empty_v1_0_0' som kan brukes til testing.",
        "parameters" : [ ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/no.domstol.innsending.models.dto.InnsendingDto"
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "201" : {
            "description" : "Kvittering på vellykket innsending av strukturerte skjema.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/no.domstol.innsending.models.dto.generell.InnsendingKvitteringResponseDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Noe gikk galt med deserialiseringen av innholdet.",
            "headers" : { }
          },
          "401" : {
            "description" : "Mangler gyldig autorisasjon for å sende inn til domstolen.",
            "headers" : { }
          },
          "500" : {
            "description" : "En uventet feil oppstod.",
            "headers" : { }
          }
        },
        "deprecated" : false,
        "security" : [ {
          "Maskinporten" : [ ]
        } ]
      }
    },
    "/api/offentlig/innsendinger/vedlegg" : {
      "post" : {
        "tags" : [ "Innsending av filer" ],
        "summary" : "Opplastning av vedlegg",
        "description" : "Et POST-endepunkt for å sende inn vedlegg. Vedlegg skal lastes opp én og én før selve skjemaet lastes opp. I responsen finner du to verdier som må sendes med i selve skjemaet; én for filformat, og én for contentId.",
        "parameters" : [ ],
        "requestBody" : {
          "description" : "Opplastning av vedlegg som multipart/form-data",
          "content" : {
            "multipart/form-data" : {
              "schema" : {
                "type" : "object",
                "properties" : {
                  "file" : {
                    "type" : "string",
                    "format" : "binary"
                  },
                  "description" : {
                    "type" : "string",
                    "title" : "String"
                  }
                },
                "required" : [ "file" ]
              }
            }
          },
          "required" : false
        },
        "responses" : {
          "201" : {
            "description" : "Opplastningen av vedlegget var vellykket",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/no.domstol.innsending.models.dto.generell.VedleggKvitteringDto"
                }
              }
            }
          },
          "400" : {
            "description" : "Noe gikk galt med deserialiseringen av innholdet.",
            "headers" : { }
          },
          "401" : {
            "description" : "Mangler gyldig autorisasjon for å sende inn til domstolen.",
            "headers" : { }
          },
          "500" : {
            "description" : "En uventet feil oppstod.",
            "headers" : { }
          }
        },
        "deprecated" : false,
        "security" : [ {
          "Maskinporten" : [ ]
        } ]
      }
    }

{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital innsending til Domstolene",
    "description": "_Dette APIet er under utvikling og vil kunne endres fortløpende._\n\nEn innsending består av et utfylt skjema og en liste med vedlegg.\n\nDersom en innsending skal inneholde vedlegg, lastes disse opp først via eget endepunkt som svarer med\nkvittering. Kvittering(er) inkluderes så i innsendingen.\n\nDet er definert et sett med skjemaspesifikasjoner som kan sendes inn.\nDet utfylte skjemaet må samsvare med en av spesifikasjonene.",
    "contact": {
      "name": "Domstoladministrasjonen",
      "url": "https://domstol.no",
      "email": "postmottak@domstol.no"
    },
    "version": "v0.0.1"
  },
  "externalDocs": {
    "description": "Dokumentasjon på Github",
    "url": "https://github.com/domstolene/digital-innsending"
  },
  "servers": [
    {
      "url": "https://innsending.test.domstol.no",
      "description": "Testmiljø"
    },
    {
      "url": "http://localhost:8080",
      "description": "Lokalt utviklingsmiljø"
    }
  ],
  "tags": [
    {
      "name": "Strukturert innsending",
      "description": "Strukturert innsending til domstolene"
    },
    {
      "name": "Innsending av filer",
      "description": "Innsending av filer til domstolene"
    }
  ],
  "paths": {
    "/api/offentlig/innsendinger/strukturert": {
      "post": {
        "tags": ["Strukturert innsending"],
        "summary": "Opplastning av strukturerte skjema",
        "description": " Et POST-endepunkt for å sende inn strukturerte skjema.\n Sendes inn etter at eventuelle vedlegg har blitt lastet opp på vedlegg-endepunktet.\n\n Skjemadefinisjonen finnes i Schema-seksjonen og heter 'SkjemaDto'.\n Det finnes også en skjemadefinisjon som heter 'Empty_v1_0_0' som kan brukes til testing.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InnsendingDto"
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "description": "Kvittering på vellykket innsending av strukturerte skjema.",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InnsendingKvitteringResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Noe gikk galt med deserialiseringen av innholdet.",
            "headers": {}
          },
          "401": {
            "description": "Mangler gyldig autorisasjon for å sende inn til domstolen.",
            "headers": {}
          },
          "500": {
            "description": "En uventet feil oppstod.",
            "headers": {}
          }
        },
        "deprecated": false
      }
    },
    "/api/offentlig/innsendinger/vedlegg": {
      "post": {
        "tags": ["Innsending av filer"],
        "summary": "Opplastning av vedlegg",
        "description": "Et POST-endepunkt for å sende inn vedlegg. Vedlegg skal lastes opp én og én før selve skjemaet lastes opp. I responsen finner du to verdier som må sendes med i selve skjemaet; én for filformat, og én for contentId.",
        "parameters": [],
        "requestBody": {
          "description": "Opplastning av vedlegg som multipart/form-data",
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "title": "File"
                  },
                  "description": {
                    "type": "string",
                    "title": "String"
                  }
                },
                "required": ["file"]
              }
            }
          },
          "required": false
        },
        "responses": {
          "201": {
            "description": "Opplastningen av vedlegget var vellykket",
            "headers": {},
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VedleggKvitteringDto"
                }
              }
            }
          },
          "400": {
            "description": "Noe gikk galt med deserialiseringen av innholdet.",
            "headers": {}
          },
          "401": {
            "description": "Mangler gyldig autorisasjon for å sende inn til domstolen.",
            "headers": {}
          },
          "500": {
            "description": "En uventet feil oppstod.",
            "headers": {}
          }
        },
        "deprecated": false,
        "security": [
          {
            "Maskinporten": []
          }
        ]
      }
    }
  },
